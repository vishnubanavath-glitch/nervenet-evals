# nervenet-evals settings. Copy to .env and fill in.
# Anything not set here is taken from ../mcp-utilities/.env (database, MCP, ANTHROPIC_API_KEY...).
# Values here win over the app's .env.

# Default dataset when --dataset is not given (folder name under datasets/).
EVAL_DATASET=tgspdcl_meter_readings

# Judge model (scores answers). Must differ from the models under test.
JUDGE_MODEL=claude-opus-5-5

# Optional: a separate Anthropic key for eval runs (otherwise the app's key is used).
# ANTHROPIC_API_KEY=

# Confident AI dashboard. Leave empty to keep results local only.
CONFIDENT_API_KEY=

# MCP server the chat calls during evals (same as the app default).
# MCP_SERVER_URLS=http://127.0.0.1:8002/mcp

# DeepEval sends anonymous usage telemetry unless this is set.
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Judge runs can take a while (Faithfulness reads long tool output). Seconds per metric task.
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=900
