# NV_DASH_START_PAGE (home | chat | tools | schema | goldens | evaluate) picks the first page; used by tests.
_START = os.getenv("NV_DASH_START_PAGE", "home")
PAGE_HOME = st.Page(page_home, title="Home", icon=":material/home:", default=_START == "home")
PAGE_CHAT = st.Page(page_chat, title="Chat results", icon=":material/forum:", url_path="chat", default=_START == "chat")
PAGE_TOOLS = st.Page(page_tools, title="Tools results", icon=":material/build:", url_path="tools",
                     default=_START == "tools")
PAGE_SCHEMA = st.Page(page_schema, title="Schema context", icon=":material/table_chart:", url_path="schema",
                      default=_START == "schema")
PAGE_GOLDENS = st.Page(page_goldens, title="Golden datasets", icon=":material/dataset:", url_path="goldens",
                       default=_START == "goldens")
PAGE_LAUNCH = st.Page(page_launch, title="Run evaluation", icon=":material/play_circle:", url_path="evaluate",
                      default=_START == "evaluate")

st.logo(str(Path(__file__).resolve().parent / "assets" / "logo.svg"), size="large")
st.navigation([PAGE_HOME, PAGE_CHAT, PAGE_TOOLS, PAGE_SCHEMA, PAGE_GOLDENS, PAGE_LAUNCH], position="top").run()
